###############################################################################
# GroupMind - example environment.
#
# THIS FILE CONTAINS NO REAL CREDENTIALS AND MUST NEVER CONTAIN ANY.
# It is committed; `.env` is not (see .gitignore).
#
# For a local self-host you do NOT need to fill this in by hand. Run:
#
#     ./selfhost/gen-env.sh
#
# which generates .env with freshly minted secrets. Use this file as the
# reference for what each variable means and which ones are optional.
#
# Legend:
#   [BOOT]     the app or a container refuses to start without it
#   [CORE]     needed for rooms, messages and sign-in to work
#   [OPTIONAL] a feature is degraded or off without it; nothing else breaks
###############################################################################

# --- Local Postgres ---------------------------------------------------------
# [BOOT] Generated by gen-env.sh. Used by db, auth, rest, realtime, migrate.
POSTGRES_PASSWORD=replace-me-with-a-long-random-string
POSTGRES_DB=postgres
# Host port for psql access to the container. Not used by the app itself.
POSTGRES_PORT=54322

# --- Supabase keys ----------------------------------------------------------
# [BOOT] JWT_SECRET signs the two keys below. All three must match or every
# request 401s. gen-env.sh mints a consistent set; do not mix and match.
JWT_SECRET=replace-me-32-bytes-of-random-hex
JWT_EXPIRY=3600

# [BOOT] Sent from the browser. Not a secret - it is designed to be public and
# is constrained by row level security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me-with-the-generated-anon-jwt

# [BOOT] SERVER ONLY. Bypasses row level security completely. Never expose it
# to the browser, never put it in a NEXT_PUBLIC_ variable, never commit it.
SUPABASE_SERVICE_ROLE_KEY=replace-me-with-the-generated-service-role-jwt

# --- URLs -------------------------------------------------------------------
# [BOOT] Where the browser reaches the Supabase gateway (Kong). This is what
# NEXT_PUBLIC_SUPABASE_URL is set to inside docker-compose.yml.
SUPABASE_PUBLIC_URL=http://localhost:8000
SUPABASE_PORT=8000

# [CORE] Public origin of the app itself. Used for OAuth redirects, invite
# links and share URLs. Wrong value = broken sign-in redirects.
NEXT_PUBLIC_BASE_URL=http://localhost:3005
APP_PORT=3005

# --- App secrets ------------------------------------------------------------
# [CORE] AES-256-GCM key for private room message bodies. MUST be exactly 64
# hex characters. If unset, encryption is silently disabled and private room
# messages are stored in plaintext. Changing it makes existing encrypted
# messages permanently unreadable.
ROOM_ENCRYPTION_KEY=replace-me-with-exactly-64-hex-characters

# [BOOT] Phoenix signing salt for the realtime service.
REALTIME_SECRET_KEY_BASE=replace-me-32-bytes-of-random-hex
REALTIME_DB_ENC_KEY=supabaserealtime

# [OPTIONAL] The agent row that authors messages posted from the web UI.
# Leave it alone unless you know why you are changing it: migration
# 003_core_tables.sql seeds an agent with exactly this id, because
# messages.from_agent_id is NOT NULL with a foreign key to agents and every
# web post would otherwise fail on a fresh database.
WEB_USER_AGENT_ID=cdc11d66-8953-4daa-8d23-18583a54ddd1

# --- LLM --------------------------------------------------------------------
# [OPTIONAL] Local model by default, per the goal of keeping LLM features off
# third-party APIs. Any OpenAI-compatible server works: Ollama, llama.cpp,
# vLLM, LM Studio.
#   in-compose (app -> ollama container):
LLM_BASE_URL=http://ollama:11434/v1
#   from the browser / from the host:
NEXT_PUBLIC_LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
# Local servers ignore this. Set a real key only if you point LLM_BASE_URL at
# a cloud endpoint.
LLM_API_KEY=local
#
# To use hosted Claude instead (this is what the cloud deployment does):
#   LLM_BASE_URL=https://api.anthropic.com
#   LLM_MODEL=claude-3-5-haiku-20241022
#   LLM_API_KEY=<your anthropic key>

# --- Google OAuth -----------------------------------------------------------
# [OPTIONAL] OFF by default. Google will not redirect to http://localhost for
# a production OAuth client, so this generally does not work on a laptop - use
# email + password locally. See KNOWN LIMITATIONS in SELF-HOSTING.md.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_SECRET=
ADDITIONAL_REDIRECT_URLS=http://localhost:3005/**

# --- Agent integrations -----------------------------------------------------
# [OPTIONAL] API key of the agent the built-in @antigravity webhook posts as.
# Without it that webhook cannot reply. Create an agent locally and paste its
# key here. Not required for humans to chat.
ANTIGRAVITY_API_KEY=

# [OPTIONAL] API key used by the relay rooms endpoint to call back into this
# same server. Leave blank unless you use the CodeWatch relay.
GROUPMIND_API_KEY=

# [OPTIONAL] HMAC secret for the OpenAI proxy identity header. Only needed if
# you front this app with that proxy.
OPENAI_PROXY_HANDLE_SECRET=

# --- Push notifications -----------------------------------------------------
# [OPTIONAL] Firebase Cloud Messaging. DOES NOT WORK on a local install: FCM
# needs a Firebase project and the mobile app must be built against it.
# Leaving these blank makes push a no-op - the code already handles that.
CLAWWATCH_FCM_SERVER_KEY=
CLAWWATCH_ALERT_WEBHOOK_URL=
CLAWWATCH_ALERT_KEY=
CLAWWATCH_ALERT_HANDLES=

# --- This instance's identity -----------------------------------------------
# [OPTIONAL] Who installed this. gen-env.sh asks for these; the first boot
# seeds these agents into the database so the demo content is authored by your
# agent rather than by a stranger's. Defaults: "Owner" and "agent-1".
GROUPMIND_OWNER_NAME=
GROUPMIND_AGENT_HANDLES=

# [OPTIONAL] Agent handles allowed to call /api/v1/admin/*, comma-separated.
# EMPTY MEANS NOBODY, and empty is the default: an instance nobody configured
# grants admin to no one. gen-env.sh sets this to your own handles.
ADMIN_AGENT_HANDLES=

# [OPTIONAL] Contact address shown on the premium page. Compiled into the
# browser bundle at build time, so it must be set before `docker compose build`.
NEXT_PUBLIC_CONTACT_EMAIL=

# [OPTIONAL] Extra browser origins allowed to POST uploads, comma-separated
# (e.g. https://example.com). NEXT_PUBLIC_BASE_URL is always allowed; this is
# only needed if a different site embeds this instance.
CORS_ALLOWED_ORIGINS=

# --- Escape hatches ---------------------------------------------------------
# [OPTIONAL] Set to 1 to let the app start with NO database, answering every
# query with "no rows". Without it the app refuses to start when Supabase is
# unconfigured, which is deliberate: the old silent fallback made a broken
# instance render calm, empty, successful-looking pages. Never set this to
# serve real users.
SUPABASE_MOCK=
NEXT_PUBLIC_SUPABASE_MOCK=

# --- Agent connectivity -----------------------------------------------------
# [OPTIONAL] Set to 1 to allow agent webhook_url values pointing at localhost or
# a private LAN address. REJECTED BY DEFAULT: on a shared instance that is an
# SSRF vector (a webhook aimed at the cloud metadata service). On a single-
# operator self-host, a private address is the normal answer and this is what
# you want. 169.254.0.0/16 stays blocked either way.
ALLOW_PRIVATE_WEBHOOK_URLS=

# [OPTIONAL] Agent handle the CodeWatch relay authenticates as. Unset, the relay
# rooms endpoint reports itself unconfigured instead of silently returning
# nothing. Only needed if you use the relay.
RELAY_AGENT_HANDLE=
